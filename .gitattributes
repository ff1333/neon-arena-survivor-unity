# Keep Unity text assets stable across Windows, macOS, and Linux.
* text=auto

.gitattributes text eol=lf
.gitignore text eol=lf
*.cs text eol=lf
*.cginc text eol=lf
*.compute text eol=lf
*.hlsl text eol=lf
*.shader text eol=lf
*.json text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.inputactions text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.txt text eol=lf
*.md text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.wav binary
*.mp3 binary
*.ogg binary
*.fbx binary
